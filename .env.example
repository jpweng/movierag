# Copy this file to .env and fill in the keys. Never commit .env.

# --- data sources -----------------------------------------------------------
# TMDb: https://www.themoviedb.org/settings/api  (use EITHER the v3 key OR the read token)
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_LANGUAGE=en-US
WATCH_REGION=CH

# YouTube Data API v3: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- LLM ----------------------------------------------------------------------
# hf          = Qwen via transformers on your GPU (default)
# ollama      = a model served by Ollama on localhost
# openai_like = any OpenAI-compatible server (e.g. vLLM on Modal, see deploy/)
LLM_BACKEND=hf
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_LOAD_IN_4BIT=true
OLLAMA_MODEL=qwen3.5:4b
OPENAI_LIKE_BASE_URL=
OPENAI_LIKE_MODEL=
OPENAI_LIKE_API_KEY=

# --- retrieval models ---------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- where generated state goes (index, API cache) ----------------------------
# Keep this OUTSIDE Google Drive: Chroma uses SQLite, which hates synced folders.
# MOVIERAG_HOME=C:\Users\jpaul\.movierag

# Run everything with mock models and no API calls (plumbing check):
MOVIERAG_OFFLINE=false
